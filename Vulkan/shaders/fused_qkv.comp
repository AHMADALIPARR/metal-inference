#version 450
// fused_qkv.comp — manual GLSL port of Sources/Kernels/
// fused_qkv_tiled.metal kernel `fused_qkv_int4` (Scheme C):
//   Q = X @ Wq^T, K = X @ Wk^T, V = X @ Wv^T
//   w = signed_nibble * scale[col*(K/64) + k/64], group 64
//   X tile loaded once into shared memory, three projections read it.
//   out = half(fma accumulation) — FP16 output rounding per lane.
//
// Tile-geometry divergence (documented, math identical): the Metal
// kernel tiles 64x64 with simdgroup matrix work and a 256-thread
// group; this port uses one workgroup per token row, the X row in
// shared memory, and threads strided over output columns. The
// accumulation per output lane is serial over K in both versions;
// only the thread mapping differs. Shared X is capped at K <= 3072
// (the repo's maximum hidden size); the graph validates K against
// that bound before dispatch.
//
// ABI: FP16 values as uint bit patterns; packed weights as uint
// arrays (little-endian byte order = Metal uchar arrays); scales
// are flat FP16 arrays (two per uint).
//   binding 0: Wq packed, 1: Sq scales, 2: Wk packed, 3: Sk scales,
//   4: Wv packed, 5: Sv scales, 6: X (FP16 bits), 7: Q (FP16 bits),
//   8: K (FP16 bits), 9: V (FP16 bits)
//   push constants: { K, Nq, Nk, Nv }  (16 bytes)
//   spec constant 0: workgroup size
// Sync: one barrier after the shared X load; rows independent.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Wq { uint wq_[]; };
layout(set = 0, binding = 1) readonly buffer Sq { uint sq_[]; };
layout(set = 0, binding = 2) readonly buffer Wk { uint wk_[]; };
layout(set = 0, binding = 3) readonly buffer Sk { uint sk_[]; };
layout(set = 0, binding = 4) readonly buffer Wv { uint wv_[]; };
layout(set = 0, binding = 5) readonly buffer Sv { uint sv_[]; };
layout(set = 0, binding = 6) readonly buffer X  { uint x_[]; };
layout(set = 0, binding = 7) writeonly buffer Q { uint q_[]; };
layout(set = 0, binding = 8) writeonly buffer K { uint k_[]; };
layout(set = 0, binding = 9) writeonly buffer V { uint v_[]; };

layout(push_constant) uniform Push {
  uint K;
  uint Nq;
  uint Nk;
  uint Nv;
} pc;

shared uint xsh_[3072];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

float scale_c(uint scales_base, uint col, uint lane) {
  uint groups = (pc.K + 63u) / 64u;
  uint idx = col * groups + lane / 64u;
  uint word;
  if (scales_base == 0u) word = sq_[idx >> 1];
  else if (scales_base == 1u) word = sk_[idx >> 1];
  else word = sv_[idx >> 1];
  uint half_bits = ((idx & 1u) == 1u) ? (word >> 16) : (word & 0xFFFFu);
  return half_to_float(half_bits);
}

float dequant_c(uint packed_base, uint scales_base, uint col, uint lane, uint row_bytes) {
  uint byte_idx = col * row_bytes + (lane >> 1);
  uint word;
  if (packed_base == 0u) word = wq_[byte_idx >> 2];
  else if (packed_base == 1u) word = wk_[byte_idx >> 2];
  else word = wv_[byte_idx >> 2];
  uint byte_val = (word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
  uint nib = (lane & 1u) == 1u ? (byte_val >> 4) : (byte_val & 0x0Fu);
  int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
  return float(v) * scale_c(scales_base, col, lane);
}

void main() {
  uint row = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint row_bytes = (pc.K + 1u) / 2u;
  uint x_base = row * pc.K;
  for (uint i = tid; i < pc.K; i += nthreads) xsh_[i] = x_[x_base + i];
  barrier();
  for (uint col = tid; col < pc.Nq; col += nthreads) {
    float acc = 0.0;
    for (uint k = 0; k < pc.K; ++k)
      acc = fma(dequant_c(0u, 0u, col, k, row_bytes), half_to_float(xsh_[k]), acc);
    q_[row * pc.Nq + col] = float_to_half(acc);
  }
  for (uint col = tid; col < pc.Nk; col += nthreads) {
    float acc = 0.0;
    for (uint k = 0; k < pc.K; ++k)
      acc = fma(dequant_c(1u, 1u, col, k, row_bytes), half_to_float(xsh_[k]), acc);
    k_[row * pc.Nk + col] = float_to_half(acc);
  }
  for (uint col = tid; col < pc.Nv; col += nthreads) {
    float acc = 0.0;
    for (uint k = 0; k < pc.K; ++k)
      acc = fma(dequant_c(2u, 2u, col, k, row_bytes), half_to_float(xsh_[k]), acc);
    v_[row * pc.Nv + col] = float_to_half(acc);
  }
}
