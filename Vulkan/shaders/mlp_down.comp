#version 450
// mlp_down.comp — manual GLSL port of Sources/Kernels/mlp.metal
// kernel `mlp_down` (and `mlp_down_bias` with a zero bias buffer):
//   out[r] = sum_c dequant_format(w_down[r,c]) * x[c]
// X and output are FP16 (bit patterns); the INT4 decode is
// format-selected by push-constant fmt exactly as in
// int4_matvec_fmt.comp (1 = A, 2 = B, 3 = C), with the same scale
// layouts. One workgroup per output row, shared-memory tree
// reduction. Reduction order differs from the serial CPU oracle;
// comparisons use the documented tolerance.
//
// ABI:
//   binding 0: packed weights (uint), binding 1: scales (uint),
//   binding 2: x (FP16 bits), binding 3: out (FP16 bits)
//   push constants: { in_dim, out_dim, fmt }  (12 bytes)
//   spec constant 0: workgroup size (threads per row)
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Packed { uint packed_[]; };
layout(set = 0, binding = 1) readonly buffer Scales { uint scales_[]; };
layout(set = 0, binding = 2) readonly buffer X      { uint x_[]; };
layout(set = 0, binding = 3) writeonly buffer Y     { uint y_[]; };

layout(push_constant) uniform Push {
  uint in_dim;
  uint out_dim;
  uint fmt;
} pc;

shared float partial_[256];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

float scale_half_at(uint idx) {
  uint word = scales_[idx >> 1];
  uint half_bits = ((idx & 1u) == 1u) ? (word >> 16) : (word & 0xFFFFu);
  return half_to_float(half_bits);
}

uint nibble_at(uint row_byte_base, uint lane) {
  uint byte_idx = row_byte_base + (lane >> 1);
  uint word = packed_[byte_idx >> 2];
  uint byte_val = (word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
  return (lane & 1u) == 1u ? (byte_val >> 4) : (byte_val & 0x0Fu);
}

float dequant(uint row, uint lane, uint row_byte_base) {
  uint nib = nibble_at(row_byte_base, lane);
  if (pc.fmt == 1u) {
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(row);
  } else if (pc.fmt == 2u) {
    uint groups = (pc.in_dim + 31u) / 32u;
    uint slot = scales_[row * groups + lane / 32u];
    return (float(nib) - 7.5) * half_to_float(slot & 0xFFFFu);
  } else {
    uint groups = (pc.in_dim + 63u) / 64u;
    uint idx = row * groups + lane / 64u;
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(idx);
  }
}

void main() {
  uint row = gl_WorkGroupID.x;
  if (row >= pc.out_dim) return;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint row_bytes = (pc.in_dim + 1u) / 2u;
  uint row_byte_base = row * row_bytes;
  float acc = 0.0;
  for (uint c = tid; c < pc.in_dim; c += nthreads) {
    acc += dequant(row, c, row_byte_base) * half_to_float(x_[c]);
  }
  partial_[tid] = acc;
  barrier();
  for (uint stride = nthreads >> 1; stride > 0u; stride >>= 1) {
    if (tid < stride) partial_[tid] += partial_[tid + stride];
    barrier();
  }
  if (tid == 0u) y_[row] = float_to_half(partial_[0]);
}
