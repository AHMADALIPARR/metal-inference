#version 450
// layernorm.comp — manual GLSL port of Sources/Kernels/
// normalization.metal kernel `layer_norm`:
//   mean = E[x]; var = max(E[x^2] - mean^2, 0);
//   y[i] = (x[i] - mean) * safe_rsqrt(var + eps) * gain[i] + bias[i]
// (The no-bias sibling `layer_norm_no_bias` is this kernel with a
// zero bias buffer; it is not a separate shader.)
//
// ABI: FP16 values move as uint bit patterns.
//   binding 0: x (FP16 bits), binding 1: gain (FP16 bits),
//   binding 2: bias (FP16 bits), binding 3: y (FP16 bits)
//   push constants: { hidden:uint, eps:float }  (8 bytes)
//   spec constant 0: workgroup size (threads per token row, <= 256)
// Sync: shared-memory tree reduction of sum and sum-of-squares,
// same shape as rmsnorm.comp; rows are independent.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer X    { uint x_[]; };
layout(set = 0, binding = 1) readonly buffer Gain { uint gain_[]; };
layout(set = 0, binding = 2) readonly buffer Bias { uint bias_[]; };
layout(set = 0, binding = 3) writeonly buffer Y   { uint y_[]; };

layout(push_constant) uniform Push {
  uint hidden;
  float eps;
} pc;

shared float sum_[256];
shared float sumsq_[256];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

void main() {
  uint row = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint base = row * pc.hidden;
  float s = 0.0, sq = 0.0;
  for (uint i = tid; i < pc.hidden; i += nthreads) {
    float v = half_to_float(x_[base + i]);
    s += v;
    sq += v * v;
  }
  sum_[tid] = s;
  sumsq_[tid] = sq;
  barrier();
  for (uint stride = nthreads >> 1; stride > 0u; stride >>= 1) {
    if (tid < stride) {
      sum_[tid] += sum_[tid + stride];
      sumsq_[tid] += sumsq_[tid + stride];
    }
    barrier();
  }
  float mean = sum_[0] / float(pc.hidden);
  float var = sumsq_[0] / float(pc.hidden) - mean * mean;
  var = max(var, 0.0);
  float inv = inversesqrt(max(var + pc.eps, 1.0e-6));
  for (uint i = tid; i < pc.hidden; i += nthreads) {
    float v = half_to_float(x_[base + i]);
    float y = (v - mean) * inv * half_to_float(gain_[base + i])
              + half_to_float(bias_[base + i]);
    y_[base + i] = float_to_half(y);
  }
}
