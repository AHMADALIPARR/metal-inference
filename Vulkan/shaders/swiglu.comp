#version 450
// swiglu.comp — manual GLSL port of Sources/Kernels/mlp.metal
// kernel `swiglu` (and `swiglu_bias` with zero bias buffers):
//   gate[r] = sum_c dequant(w_gate[r,c]) * x[c]
//   up[r]   = sum_c dequant(w_up[r,c]) * x[c]
//   out[r]  = silu(gate[r]) * up[r]
//   silu(x) = x / (1 + exp(-clamp(x, -80, 80)))
// The Metal kernel uses Scheme A (dequant_i4); this port decodes
// format-selected (fmt push constant, 1 = A, 2 = B, 3 = C) with the
// same decode paths and scale layouts as int4_matvec_fmt.comp, so
// the graph can run it under any validated format. X and output
// are FP16 (bit patterns).
//
// ABI:
//   binding 0: w_gate packed (uint), 1: s_gate scales (uint),
//   binding 2: w_up packed (uint), 3: s_up scales (uint),
//   binding 4: x (FP16 bits), 5: out (FP16 bits)
//   push constants: { hidden, intermediate, fmt }  (12 bytes)
//   spec constant 0: workgroup size (threads per row)
// One workgroup per intermediate row; two shared partial arrays
// (gate, up); the silu is applied by thread 0 after the reduction.
// Reduction order differs from the serial CPU oracle; comparisons
// use the documented tolerance.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer WGate { uint wgate_[]; };
layout(set = 0, binding = 1) readonly buffer SGate { uint sgate_[]; };
layout(set = 0, binding = 2) readonly buffer WUp   { uint wup_[]; };
layout(set = 0, binding = 3) readonly buffer SUp   { uint sup_[]; };
layout(set = 0, binding = 4) readonly buffer X     { uint x_[]; };
layout(set = 0, binding = 5) writeonly buffer Out  { uint out_[]; };

layout(push_constant) uniform Push {
  uint hidden;
  uint intermediate;
  uint fmt;
} pc;

shared float pgate_[256];
shared float pup_[256];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

float scale_half_at(uint which, uint idx) {
  uint word = which == 0u ? sgate_[idx >> 1] : sup_[idx >> 1];
  uint half_bits = ((idx & 1u) == 1u) ? (word >> 16) : (word & 0xFFFFu);
  return half_to_float(half_bits);
}

uint nibble_at(uint which, uint row_byte_base, uint lane) {
  uint byte_idx = row_byte_base + (lane >> 1);
  uint word = which == 0u ? wgate_[byte_idx >> 2] : wup_[byte_idx >> 2];
  uint byte_val = (word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
  return (lane & 1u) == 1u ? (byte_val >> 4) : (byte_val & 0x0Fu);
}

float dequant(uint which, uint row, uint lane, uint row_byte_base) {
  uint nib = nibble_at(which, row_byte_base, lane);
  if (pc.fmt == 1u) {
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(which, row);
  } else if (pc.fmt == 2u) {
    uint groups = (pc.hidden + 31u) / 32u;
    uint slot = which == 0u ? sgate_[row * groups + lane / 32u]
                            : sup_[row * groups + lane / 32u];
    return (float(nib) - 7.5) * half_to_float(slot & 0xFFFFu);
  } else {
    uint groups = (pc.hidden + 63u) / 64u;
    uint idx = row * groups + lane / 64u;
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(which, idx);
  }
}

float silu(float x) {
  return x / (1.0 + exp(-clamp(x, -80.0, 80.0)));
}

void main() {
  uint row = gl_WorkGroupID.x;
  if (row >= pc.intermediate) return;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint row_bytes = (pc.hidden + 1u) / 2u;
  uint row_byte_base = row * row_bytes;
  float ag = 0.0, au = 0.0;
  for (uint c = tid; c < pc.hidden; c += nthreads) {
    float xv = half_to_float(x_[c]);
    ag += dequant(0u, row, c, row_byte_base) * xv;
    au += dequant(1u, row, c, row_byte_base) * xv;
  }
  pgate_[tid] = ag;
  pup_[tid] = au;
  barrier();
  for (uint stride = nthreads >> 1; stride > 0u; stride >>= 1) {
    if (tid < stride) {
      pgate_[tid] += pgate_[tid + stride];
      pup_[tid] += pup_[tid + stride];
    }
    barrier();
  }
  if (tid == 0u) out_[row] = float_to_half(silu(pgate_[0]) * pup_[0]);
}
