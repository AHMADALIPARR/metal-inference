#version 450
// rmsnorm.comp — manual GLSL port of Sources/Kernels/normalization.metal
// kernel `rmsnorm` (and `final_norm`, which has identical math):
//   inv = safe_rsqrt(mean(x^2) + eps);  y[i] = x[i] * inv * gain[i]
// safe_rsqrt(x) = rsqrt(max(x, 1e-6)) per Sources/Common/types.h.
//
// ABI: FP16 values move as uint bit patterns (one per slot).
//   binding 0: x (FP16 bits), binding 1: gain (FP16 bits),
//   binding 2: y (FP16 bits, write-only)
//   push constants: { hidden:uint, eps:float }  (8 bytes)
//   spec constant 0: workgroup size (threads per token row)
//
// Port structure: the naive Metal kernel recomputes the sum in every
// thread (O(n^2) reads). This port follows the repo's own tiled
// variant (`rmsnorm_tiled`): one workgroup per token row, threads
// cooperatively reduce sum(x^2) through shared memory, then every
// thread writes its lanes. Same math; FP32 summation order differs
// from the serial Metal loop, so comparisons use the tolerance in
// docs/PHASE_C.md. Sync: one barrier after the shared store, one
// after each tree-reduction step; no cross-workgroup sync (rows are
// independent). Requires workgroup size <= 256 (shared array size);
// the graph sets 256.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer X    { uint x_[]; };
layout(set = 0, binding = 1) readonly buffer Gain { uint gain_[]; };
layout(set = 0, binding = 2) writeonly buffer Y   { uint y_[]; };

layout(push_constant) uniform Push {
  uint hidden;
  float eps;
} pc;

shared float partial_[256];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

void main() {
  uint row = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint base = row * pc.hidden;
  float acc = 0.0;
  for (uint i = tid; i < pc.hidden; i += nthreads) {
    float v = half_to_float(x_[base + i]);
    acc += v * v;
  }
  partial_[tid] = acc;
  barrier();
  for (uint stride = nthreads >> 1; stride > 0u; stride >>= 1) {
    if (tid < stride) partial_[tid] += partial_[tid + stride];
    barrier();
  }
  float mean_sq = partial_[0] / float(pc.hidden);
  float x = mean_sq + pc.eps;
  float inv = inversesqrt(max(x, 1.0e-6));
  for (uint i = tid; i < pc.hidden; i += nthreads) {
    float v = half_to_float(x_[base + i]);
    y_[base + i] = float_to_half(v * inv * half_to_float(gain_[base + i]));
  }
}
