#version 450
// gqa_attention.comp — manual GLSL port of Sources/Kernels/
// gqa_strided.metal kernel `gqa_attention` (FP16, strided KV cache):
//   kv_head = h / (num_heads / num_kv_heads)
//   scores: s(t) = scale * sum_i Q[q][i] * K[t*kv_stride + kv_head*d + i]
//   two-pass stable softmax (max, then sum of exp), then
//   O[q][i] = sum_t exp(s(t)-m)/l * V[t*kv_stride + kv_head*d + i]
// The Metal kernel recomputes each score three times (once per
// pass); this port computes the same values in the same serial
// order per score, so scores agree with the CPU reference up to
// libm exp() last-ulp differences.
//
// ABI: FP16 values as uint bit patterns.
//   binding 0: Q (FP16 bits, [seq][heads][d]),
//   binding 1: K cache (FP16 bits, [pos][kv_stride]),
//   binding 2: V cache (FP16 bits, same layout),
//   binding 3: O (FP16 bits, [seq][heads][d])
//   push constants: { seq_len, kv_len, num_heads, num_kv_heads,
//                     head_dim, kv_stride, scale }  (28 bytes)
//   spec constant 0: workgroup size.
// One thread per (q_pos, head): global id = q_pos*num_heads + head.
// Sync: none — each output lane is written by exactly one thread.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Q { uint q_[]; };
layout(set = 0, binding = 1) readonly buffer Kc { uint kc_[]; };
layout(set = 0, binding = 2) readonly buffer Vc { uint vc_[]; };
layout(set = 0, binding = 3) writeonly buffer O { uint o_[]; };

layout(push_constant) uniform Push {
  uint seq_len;
  uint kv_len;
  uint num_heads;
  uint num_kv_heads;
  uint head_dim;
  uint kv_stride;
  float scale;
} pc;

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

float score(uint q_off, uint k_off) {
  float s = 0.0;
  for (uint i = 0; i < pc.head_dim; ++i)
    s += half_to_float(q_[q_off + i]) * half_to_float(kc_[k_off + i]);
  return s * pc.scale;
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint q_pos = gid / pc.num_heads;
  uint h = gid % pc.num_heads;
  if (q_pos >= pc.seq_len || h >= pc.num_heads) return;
  uint kv_h = h / (pc.num_heads / pc.num_kv_heads);
  uint d = pc.head_dim;
  uint q_off = q_pos * pc.num_heads * d + h * d;
  uint kv_off = kv_h * d;
  float m = -1.0 / 0.0;
  for (uint t = 0; t < pc.kv_len; ++t) {
    float s = score(q_off, t * pc.kv_stride + kv_off);
    m = max(m, s);
  }
  float l = 0.0;
  for (uint t = 0; t < pc.kv_len; ++t)
    l += exp(score(q_off, t * pc.kv_stride + kv_off) - m);
  for (uint i = 0; i < d; ++i) {
    float acc = 0.0;
    for (uint t = 0; t < pc.kv_len; ++t) {
      uint v_off = t * pc.kv_stride + kv_off;
      float w = exp(score(q_off, t * pc.kv_stride + kv_off) - m) / l;
      acc += w * half_to_float(vc_[v_off + i]);
    }
    o_[q_off + i] = float_to_half(acc);
  }
}
