#version 450
// residual.comp — manual GLSL port of Sources/Kernels/residual.metal
// kernels `residual_add` and `residual_add_scaled`:
//   out[i] = a[i] + b[i] * scale     (scale 1.0 = plain add)
// The in-place sibling `residual_add_inplace` is this kernel with
// the output buffer aliased to the input buffer; it is not a
// separate shader. FP16 values move as uint bit patterns.
//
// ABI:
//   binding 0: a (FP16 bits), 1: b (FP16 bits), 2: out (FP16 bits)
//   push constants: { hidden, scale }  (8 bytes)
//   spec constant 0: workgroup size. One thread per lane. Sync: none.
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer A   { uint a_[]; };
layout(set = 0, binding = 1) readonly buffer B   { uint b_[]; };
layout(set = 0, binding = 2) writeonly buffer Out { uint o_[]; };

layout(push_constant) uniform Push {
  uint hidden;
  float scale;
} pc;

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

uint float_to_half(float f) {
  uint bits = floatBitsToUint(f);
  uint sign = (bits >> 16) & 0x8000u;
  int exp = int((bits >> 23) & 0xFFu) - 112;
  uint frac = bits & 0x7FFFFFu;
  if (((bits >> 23) & 0xFFu) == 0xFFu) return sign | 0x7C00u | (frac != 0u ? 0x200u : 0u);
  if (exp >= 31) return sign | 0x7C00u;
  if (exp <= 0) {
    if (exp < -10) return sign;
    frac |= 0x800000u;
    int shift = 14 - exp;
    uint hf = frac >> shift;
    uint rem = frac & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1);
    if (rem > halfway || (rem == halfway && (hf & 1u) != 0u)) hf += 1u;
    return sign | hf;
  }
  uint outh = sign | (uint(exp) << 10) | (frac >> 13);
  uint rem = frac & 0x1FFFu;
  if (rem > 0x1000u || (rem == 0x1000u && (outh & 1u) != 0u)) outh += 1u;
  return outh;
}

void main() {
  uint tid = gl_GlobalInvocationID.x;
  if (tid >= pc.hidden) return;
  float v = half_to_float(a_[tid]) + half_to_float(b_[tid]) * pc.scale;
  o_[tid] = float_to_half(v);
}
