#version 450
// int4_matvec_fmt.comp — format-selected INT4 matvec. One workgroup
// per output row; shared-memory tree reduction (same shape as the
// Phase B int4_matvec.comp).
//
//   y[r] = sum_c dequant_format(w[r,c]) * x[c]
//
// The decode path is selected by push-constant `fmt` (the
// QuantFormat value in tensor_abi.h: 1 = A, 2 = B, 3 = C). The three
// decode functions are separate code paths in this shader; the
// graph validates the tensor's format against the fmt it passes,
// so a blob is never decoded under the wrong scheme. Scale layout
// (binding 1, uint array):
//   A: flat FP16 scales, one per row: word = row/2, lane = row%2.
//   B: half2 slots, one per group of 32: slot = row*groups + c/32,
//      scale = low 16 bits (.x). Groups = ceil(in_dim/32).
//   C: flat FP16 scales, one per group of 64: index =
//      row*groups + c/64, word = index/2, lane = index%2.
// Packed weights (binding 0, uint array): byte order inside each
// uint is little-endian lane order, identical to the Metal uchar
// arrays; even lane = low nibble.
//
// ABI:
//   binding 0: packed weights (uint), binding 1: scales (uint),
//   binding 2: x (float), binding 3: y (float)
//   push constants: { in_dim, out_dim, fmt }  (12 bytes)
//   spec constant 0: workgroup size (threads per row)
// Reduction order differs from the serial CPU oracle; comparisons
// use the documented tolerance (docs/PHASE_C.md).
layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) readonly buffer Packed { uint packed_[]; };
layout(set = 0, binding = 1) readonly buffer Scales { uint scales_[]; };
layout(set = 0, binding = 2) readonly buffer X      { float x_[]; };
layout(set = 0, binding = 3) writeonly buffer Y     { float y_[]; };

layout(push_constant) uniform Push {
  uint in_dim;
  uint out_dim;
  uint fmt;
} pc;

shared float partial_[256];

float half_to_float(uint h) {
  uint sign = (h >> 15) & 1u;
  uint exp = (h >> 10) & 0x1Fu;
  uint frac = h & 0x3FFu;
  if (exp == 0u) {
    if (frac == 0u) return sign == 1u ? -0.0 : 0.0;
    float v = float(frac) * (1.0 / 16777216.0);
    return sign == 1u ? -v : v;
  }
  if (exp == 31u) return sign == 1u ? -1.0/0.0 : 1.0/0.0;
  float v = (1.0 + float(frac) / 1024.0) * exp2(float(int(exp) - 15));
  return sign == 1u ? -v : v;
}

float scale_half_at(uint idx) {
  uint word = scales_[idx >> 1];
  uint half_bits = ((idx & 1u) == 1u) ? (word >> 16) : (word & 0xFFFFu);
  return half_to_float(half_bits);
}

uint nibble_at(uint row_byte_base, uint lane) {
  uint byte_idx = row_byte_base + (lane >> 1);
  uint word = packed_[byte_idx >> 2];
  uint byte_val = (word >> ((byte_idx & 3u) * 8u)) & 0xFFu;
  return (lane & 1u) == 1u ? (byte_val >> 4) : (byte_val & 0x0Fu);
}

float dequant(uint row, uint lane, uint row_byte_base) {
  uint nib = nibble_at(row_byte_base, lane);
  if (pc.fmt == 1u) { // Scheme A: signed nibble * scale[row]
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(row);
  } else if (pc.fmt == 2u) { // Scheme B: (nib - 7.5) * scale[group], group 32
    uint groups = (pc.in_dim + 31u) / 32u;
    uint slot = scales_[row * groups + lane / 32u];
    float scale = half_to_float(slot & 0xFFFFu);
    return (float(nib) - 7.5) * scale;
  } else { // Scheme C: signed nibble * scale[row*groups + lane/64], group 64
    uint groups = (pc.in_dim + 63u) / 64u;
    uint idx = row * groups + lane / 64u;
    int v = int(nib) >= 8 ? int(nib) - 16 : int(nib);
    return float(v) * scale_half_at(idx);
  }
}

void main() {
  uint row = gl_WorkGroupID.x;
  if (row >= pc.out_dim) return;
  uint tid = gl_LocalInvocationID.x;
  uint nthreads = gl_WorkGroupSize.x;
  uint row_bytes = (pc.in_dim + 1u) / 2u;
  uint row_byte_base = row * row_bytes;
  float acc = 0.0;
  for (uint c = tid; c < pc.in_dim; c += nthreads) {
    acc += dequant(row, c, row_byte_base) * x_[c];
  }
  partial_[tid] = acc;
  barrier();
  for (uint stride = nthreads >> 1; stride > 0u; stride >>= 1) {
    if (tid < stride) partial_[tid] += partial_[tid + stride];
    barrier();
  }
  if (tid == 0u) y_[row] = partial_[0];
}
